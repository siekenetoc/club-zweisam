{
    auto_https off
}

# Caddy läuft in Produktion hinter dem Host-nginx auf 127.0.0.1:8080.
# TLS und ACME werden vom Host-nginx übernommen; hier bleibt Basic Auth,
# Security-Header und Reverse Proxy zur Django-App.
http://{$DOMAIN} {
    basic_auth {
        jana-olli {$BASIC_AUTH_HASH}
    }

    encode zstd gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        Permissions-Policy "geolocation=(), microphone=(), camera=()"
    }

    reverse_proxy web:8000 {
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Host {host}
    }
}
