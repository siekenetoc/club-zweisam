# Django
DJANGO_SETTINGS_MODULE=clubzweisam.settings.dev
SECRET_KEY=change-me-in-production
DEBUG=True
ALLOWED_HOSTS=club-zweisam.localhost,localhost,127.0.0.1
DOMAIN=club-zweisam.localhost
ACME_EMAIL=admin@example.com
CSRF_TRUSTED_ORIGINS=https://club-zweisam.localhost,https://localhost

# Datenbank
POSTGRES_DB=clubzweisam
POSTGRES_USER=clubzweisam
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://clubzweisam:change-me@db:5432/clubzweisam

# Redis
REDIS_URL=redis://redis:6379/0

# Aufbewahrung und Schutz
ROULETTE_ANSWER_RETENTION_DAYS=30
PLAYBOOK_DAILY_LIMIT=3
WISH_RETENTION_DAYS=90
PORTAL_BASE_URL=https://club-zweisam.localhost
MAILHOG_DOMAIN=mail.club-zweisam.localhost

# Feldverschlüsselung (NIE ins Repo, NIE in Logs)
# Erzeugen mit: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=change-me-32-byte-base64-key
# Nur für Rotation setzen, danach wieder entfernen:
# FIELD_ENCRYPTION_KEY_OLD=alter-schluessel

# Mail
# Entwicklung: Mailhog. Produktion: echten SMTP-Server eintragen.
EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=noreply@club-zweisam.local
# Optional: EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

# Produktionsbeispiel (auskommentiert):
# EMAIL_HOST=smtp.example.org
# EMAIL_PORT=587
# EMAIL_HOST_USER=club-zweisam
# EMAIL_HOST_PASSWORD=...
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# DEFAULT_FROM_EMAIL=Club Zweisam <noreply@example.org>

# GitHub (nur für Push durch Agent, NIE ins Repo committen)
GITHUB_REPO=siekenetoc/club-zweisam
# GITHUB_DEPLOY_TOKEN=...  (nur lokal in .env, nicht committen)